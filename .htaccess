# .htaccess
Options -Indexes

# Block hidden files
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Larger design uploads (only works if PHP runs as an Apache module, as in XAMPP)
<IfModule mod_php.c>
    php_value upload_max_filesize 12M
    php_value post_max_size 14M
</IfModule>
<IfModule mod_php7.c>
    php_value upload_max_filesize 12M
    php_value post_max_size 14M
</IfModule>
<IfModule mod_php8.c>
    php_value upload_max_filesize 12M
    php_value post_max_size 14M
</IfModule>
